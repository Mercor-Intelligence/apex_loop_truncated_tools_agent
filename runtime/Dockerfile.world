# The world sidecar for a Harbor task: the archipelago environment plus the boot
# glue that seeds a world and mounts its MCP servers.
#
# Build the base first (it is the stock environment image, unchanged):
#   docker build -t archipelago-environment:base -f environment/Dockerfile .
#   docker build -t archipelago-harbor-world:latest -f harbor/Dockerfile.world .
ARG BASE_IMAGE=archipelago-environment:base
FROM ${BASE_IMAGE}

COPY tools/ /app/tools/
RUN chmod +x /app/tools/start.sh /app/tools/*.py

# World data is mounted read-only per trial rather than baked, so one image
# serves every world and no trial can mutate the seed.
ENV PORT=8000 \
    WORLD_DATA_DIR=/world \
    TASK_FILES_DIR=/task_files \
    WORLD_LOGS_DIR=/logs/world

# The MCP servers launch via `uv run`, which re-resolves `build-system.requires` from PyPI whenever
# it decides to rebuild a local path package — so a world that boots fine normally dies whenever the
# container has no egress. The image already ships every server's .venv plus a warm uv cache, so pin
# uv offline: boot then resolves from that cache and never depends on the network.
ENV UV_OFFLINE=1

EXPOSE 8000
CMD ["/app/tools/start.sh"]
